# Copiar a .env y completar. Nunca subir .env ni la carpeta certs/ al repo.
ARCA_ENV=homo            # homo (pruebas) | prod
ARCA_CUIT=20123456789    # CUIT del titular del certificado, sin guiones
ARCA_CERT=certs/arca.crt # certificado emitido por ARCA
ARCA_KEY=certs/arca.key  # clave privada con la que se generó el CSR
# ARCA_SIGNER=openssl    # opcional: firmar el TRA con openssl en vez de node-forge

# Conexión con PFOS (solo lectura, solo la cuenta de Mercado Libre del contribuyente). Ver docs/pfos-conexion.md.
# FISCALOS_PFOS_HOST=<host del proyecto de PFOS Mercado Libre en Neon, ej. ep-xxxx.sa-east-1.aws.neon.tech>
# FISCALOS_PFOS_BASE=<nombre de la base, ej. neondb>
# FISCALOS_PFOS_CLAVE la escribe «fiscalos.ps1 pfos-clave» (no se escribe a mano)
# FISCALOS_PFOS_CUENTA=<user_id de Mercado Libre de la cuenta de tu CUIT>      # obligatorio
# FISCALOS_PFOS_EXCLUIDAS=<user_id de la otra cuenta>                         # nunca se lee
# (alternativa a HOST/BASE/CLAVE: FISCALOS_PFOS_URL=postgresql://fiscalos_lectura:<clave codificada>@<host>/<base>?sslmode=require)
