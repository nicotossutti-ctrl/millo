# Copiar a .env y completar. Nunca subir .env ni la carpeta certs/ al repo.
ARCA_ENV=homo            # homo (pruebas) | prod
ARCA_CUIT=20123456789    # CUIT del titular del certificado, sin guiones
ARCA_CERT=certs/arca.crt # certificado emitido por ARCA
ARCA_KEY=certs/arca.key  # clave privada con la que se generó el CSR
# ARCA_SIGNER=openssl    # opcional: firmar el TRA con openssl en vez de node-forge
